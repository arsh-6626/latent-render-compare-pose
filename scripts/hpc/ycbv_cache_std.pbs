#!/bin/bash
# YCB-V PBR + real token cache on the cluster (train_real is only here): BOP dataset caches built scene-parallel
# (build_bop_cache.py), then scripts/tless/build_cache.sh with bop.ds_config["ycbv"] (LiePose's own crops of
# train_pbr + train_real -> frozen DINOv2 on the CPU -> crop meta) into $P/data/ycbv_tokens_pr. The test tokens are
# re-encoded the same way and compared with the GPU-encoded ycbv_tokens (same crops). Standard queue, dtu001.
#   j=$(qsub -N ycv-cache ycbv_cache_std.pbs)
#   qsub -N ycf2-v2 -W depend=afterok:$j -v STAGE=field ycbv_field_std.pbs
#PBS -P hpc.dtu.kavinder
#PBS -q standard
#PBS -l select=1:ncpus=12:ngpus=1:mem=96gb:centos=icelake
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /scratch/hpc/visitor/dtu001.visitor/liepose/logs/

P=/scratch/hpc/visitor/dtu001.visitor/liepose
C=$P/code_ycbv; cd $C
hostname
PY=$P/env/liepose/bin/python
export DATADIR=$P/data CACHE_ROOT_PATH=$P/data/bop_cache PYTHONPATH=$C/src:$C/lib/bop_toolkit BOP_DS=ycbv
export TORCH_HOME=$P/torch_home XDG_CACHE_HOME=$P/xdg_cache OMP_NUM_THREADS=12 JAX_PLATFORMS=cpu
L=$P/logs/logs/ycbv_cache_pr.log
for d in ycbv-train_pbr ycbv-train_real ycbv-test; do
  $PY -u scripts/tless/build_bop_cache.py $d --procs 12 >> $L 2>&1 || { echo "cache $d failed"; exit 1; }
done
JAX_PY=$PY TORCH_PY=$PY TOK=$P/data/ycbv_tokens_pr N=180000 bash scripts/tless/build_cache.sh >> $L 2>&1 || exit 1
$PY - >> $L 2>&1 <<EOF
import numpy as np
a = np.load("$P/data/ycbv_tokens_pr/test_tokens.npy", mmap_mode="r"); b = np.load("$P/data/ycbv_tokens/test_tokens.npy", mmap_mode="r")
ma, mb = np.load("$P/data/ycbv_tokens_pr/test_meta.npz"), np.load("$P/data/ycbv_tokens/test_meta.npz")
print("test crops", a.shape, b.shape, "same index", np.array_equal(ma["index"], mb["index"]))
d = np.abs(a.astype(np.float32) - b.astype(np.float32))
print("CPU vs GPU test tokens: mean |d| %.4g, max %.4g, mean |token| %.4g" % (d.mean(), d.max(), np.abs(b).astype(np.float32).mean()))
EOF
echo "YCBV_CACHE_DONE $?"
