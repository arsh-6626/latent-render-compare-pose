#!/bin/bash
# World-model-conditioned LiePose on SYMSOL-T (week 2). Submit with:
#   qsub -N cmp-<mode> -v COND=<none|pooled|compare> scripts/hpc/cmp_symsolt_scai.pbs
# A100 scai_q nodes (RHEL9). 24 h hard cap; resubmit the same COND to resume from the last checkpoint.
# Resumable: resubmitting the same COND continues from the latest checkpoint (saved every 50k steps).
#
#PBS -P hpc.dtu.kavinder
#PBS -q scai_q
#PBS -l select=1:ncpus=16:ngpus=1:mem=128gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /scratch/hpc/visitor/dtu001.visitor/liepose/logs/

P=/scratch/hpc/visitor/dtu001.visitor/liepose
cd $P/code
hostname
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv

export DATADIR=$P/data
export PYTHONPATH=$P/code/src
export TORCH_HOME=$P/torch_home
export XDG_CACHE_HOME=$P/xdg_cache
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.9
export HF_HUB_OFFLINE=1

$P/env/liepose/bin/python -u -m liepose.exp.cmp.run \
  --root_path $P/logs/experiments/symsolt-cmp \
  "cond_mode=[${COND}]" "cond_gate_t=[${GATE:--1}]" "n_slices=[64]" \
  "wm_dir=[$P/data/wm_v3_soft15]" "cache_dir=[$P/data/dino_cache]" \
  > $P/logs/cmp_${COND}_${PBS_JOBID}.log 2>&1

echo CMP_DONE
