#!/bin/bash
# 3D-consistent feature field (liepose.exp.jepa_probe.feat_field) on SPEED+, dtu004 account; code from $P/code_larp
# (the LARp repo). Tokens staged on node-local disk. Re-submitting starts over.
#   qsub -N ffield -v OUT=sp_ffield_v2 ffield_dtu004.pbs
#PBS -P hpc.dtu.kavinder
#PBS -q scai_q
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /scratch/hpc/visitor/dtu004.visitor/larp/logs/

P=/scratch/hpc/visitor/dtu001.visitor/liepose
W=/scratch/hpc/visitor/dtu004.visitor/larp; mkdir -p $W/logs $W/probe
cd $P/code_larp
hostname
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv
T=${TMPDIR:-/tmp}/ff_${PBS_JOBID%%.*}; mkdir -p $T/data; trap "rm -rf $T" EXIT
for f in $P/data/*; do ln -s $f $T/data/; done
rm $T/data/speedplus_tokens; cp -rL $P/data/speedplus_tokens $T/data/ || exit 1
export DATADIR=$T/data SPEEDPLUS_ROOT=$P/data/speedplusv2
export PYTHONPATH=$P/code_larp/src:$P/code_larp/lib/bop_toolkit XLA_PYTHON_CLIENT_MEM_FRACTION=0.9
$P/env/liepose/bin/python -u -m liepose.exp.jepa_probe.feat_field --out $W/probe/${OUT:-sp_ffield_v2} ${ARGS} >> $W/logs/${OUT:-sp_ffield_v2}.log 2>&1
echo "FFIELD_DONE $?"
