#!/bin/bash
# T-LESS latent render-and-compare denoiser at LiePose's training budget (400k steps, batch 64), dtu001 account.
# n_slices 64 (LiePose: 256): every noisy pose runs the world model. Re-submitting resumes from the latest checkpoint.
#   qsub -N tl400-dit -v MODE=dit tless_lrc400k_scai.pbs      (MODE=dit_nowm for the control)
#PBS -P hpc.dtu.kavinder
#PBS -q scai_q
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /scratch/hpc/visitor/dtu001.visitor/liepose/logs/

P=/scratch/hpc/visitor/dtu001.visitor/liepose
cd $P/code_lrc
hostname
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv

# stage the token cache on node-local disk: random per-step reads of the 8.3 GB memmap from Lustre ran at ~12 s/it
T=${TMPDIR:-/tmp}/lrc_${PBS_JOBID%%.*}; mkdir -p $T/data; trap "rm -rf $T" EXIT
df -h $T | tail -1
for f in $P/data/*; do ln -s $f $T/data/; done
rm $T/data/tless_tokens
if ! cp -rL $P/data/tless_tokens $T/data/; then  # local disk too small: hold it in RAM
  rm -rf $T/data/tless_tokens; mkdir -p /dev/shm/lrc_${PBS_JOBID%%.*}; trap "rm -rf $T /dev/shm/lrc_${PBS_JOBID%%.*}" EXIT
  cp -rL $P/data/tless_tokens /dev/shm/lrc_${PBS_JOBID%%.*}/ || exit 1; ln -s /dev/shm/lrc_${PBS_JOBID%%.*}/tless_tokens $T/data/
fi
du -sh $T/data/tless_tokens
export DATADIR=$T/data
export PATH=$P/env/liepose/bin:$PATH  # bop_toolkit error scripts run as `python` subprocesses
export PYTHONPATH=$P/code_lrc/src:$P/code/lib/bop_toolkit
export TORCH_HOME=$P/torch_home XDG_CACHE_HOME=$P/xdg_cache CACHE_ROOT_PATH=$P/data/bop_cache
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.9 BOP_RENDERER=vispy
mkdir -p $P/logs/experiments/tless-lrc

$P/env/liepose/bin/python -u -m liepose.exp.cmp.tless_dit --root_path $P/logs/experiments/tless-lrc "den_mode=[$MODE]" \
  "wm_dir=[$P/data/probe/tless_ret_v1]" "train_steps=[400000]" "batch_size=[64]" "n_slices=[64]" "num_workers=[8]" \
  >> $P/logs/tless_lrc400k_${MODE}.log 2>&1
echo "TLESS_LRC400K_DONE $?"
