#!/bin/bash
# SPEED+ latent render-and-compare with the DINOv2 backbone trained (sp_dit dit_ft / dit_nowm_ft), the sp400-geo
# setup otherwise (sp_geo_v1, 400k steps, batch 64 x 64 slices), dtu001 account. Trains on LiePose's on-the-fly
# augmented crops of the synthetic frames; tests on the official lightbox / sunlamp crops (crop shards with images).
# Re-submitting resumes from the latest checkpoint.
#   qsub -N ft400-wm   -v MODE=dit_ft      speedplus_ft400k_scai.pbs
#   qsub -N ft400-nowm -v MODE=dit_nowm_ft speedplus_ft400k_scai.pbs   (control: same backbone, no world model)
#PBS -P hpc.dtu.kavinder
#PBS -q scai_q
#PBS -l select=1:ncpus=16:ngpus=1:mem=128gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /scratch/hpc/visitor/dtu001.visitor/liepose/logs/

P=/scratch/hpc/visitor/dtu001.visitor/liepose
cd $P/code_lrc
hostname
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv

T=${TMPDIR:-/tmp}/ft_${PBS_JOBID%%.*}; mkdir -p $T/data; trap "rm -rf $T" EXIT
df -h $T | tail -1
for f in $P/data/*; do ln -s $f $T/data/; done
rm $T/data/speedplus_tokens $T/data/speedplus_crops
cp -rL $P/data/speedplus_tokens $T/data/ || exit 1
mkdir -p $T/data/speedplus_crops
ln -s $P/data/speedplus_crops/train $T/data/speedplus_crops/train
for s in val lightbox sunlamp; do ln -s $P/data/speedplus_crops_img/$s $T/data/speedplus_crops/$s; done
# the synthetic frames on the node's local disk (the data loader reads 64 full frames per step)
mkdir -p $T/speedplusv2
for f in $P/data/speedplusv2/*; do ln -s $f $T/speedplusv2/; done
rm $T/speedplusv2/synthetic; mkdir -p $T/speedplusv2/synthetic
cp $P/data/speedplusv2/synthetic/*.json $T/speedplusv2/synthetic/
cp -r $P/data/speedplusv2/synthetic/images $T/speedplusv2/synthetic/ || exit 1
du -sh $T/data/speedplus_tokens $T/speedplusv2/synthetic/images

export DATADIR=$T/data SPEEDPLUS_ROOT=$T/speedplusv2
export PYTHONPATH=$P/code_lrc/src:$P/code/lib/bop_toolkit
export TORCH_HOME=$P/torch_home XDG_CACHE_HOME=$P/xdg_cache
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.9
mkdir -p $P/logs/experiments/speedplus-lrc

$P/env/liepose/bin/python -u -m liepose.exp.cmp.sp_dit --root_path $P/logs/experiments/speedplus-lrc "den_mode=[$MODE]" \
  "wm_dir=[$P/data/probe/sp_geo_v1]" "train_steps=[400000]" "batch_size=[64]" "n_slices=[64]" "num_workers=[14]" \
  >> $P/logs/speedplus_ft400k_${MODE}.log 2>&1
echo "SPEEDPLUS_FT400K_DONE $?"
